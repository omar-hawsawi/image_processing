  },
  {
   "cell_type": "code",
   "execution_count": 6,
   "id": "b0debb93",
   "metadata": {},
   "outputs": [],
   "source": [
    "from PIL import Image as image\n",
    "from PIL import ImageChops as imgch\n",
    "img=image.open(\"mario.jpg\")\n",
    "size=img.resize((500,500))\n",
    "rotated=img.rotate(120)\n",
    "shear=img.transform((500,500), image.AFFINE, (1, 0.5, 0, 0.5, 1, 0))\n"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "6c3d2b46",
   "metadata": {},
   "source": [
    "task2"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 7,
   "id": "3205f3d3",
   "metadata": {},
   "outputs": [
    {
     "ename": "NameError",
     "evalue": "name 'imagch' is not defined",
     "output_type": "error",
     "traceback": [
      "\u001b[31m---------------------------------------------------------------------------\u001b[39m",
      "\u001b[31mNameError\u001b[39m                                 Traceback (most recent call last)",
      "\u001b[36mCell\u001b[39m\u001b[36m \u001b[39m\u001b[32mIn[7]\u001b[39m\u001b[32m, line 4\u001b[39m\n\u001b[32m      1\u001b[39m \u001b[38;5;28;01mimport\u001b[39;00m cv2\n\u001b[32m      2\u001b[39m \u001b[38;5;28;01mimport\u001b[39;00m numpy \u001b[38;5;28;01mas\u001b[39;00m np\n\u001b[32m      3\u001b[39m imgc=cv2.imread(\u001b[33m\"image.jpg\"\u001b[39m)\n\u001b[32m----> \u001b[39m\u001b[32m4\u001b[39m negative=imagch.invert(img)\n\u001b[32m      5\u001b[39m img_float = img.astype(np.float32)\n\u001b[32m      6\u001b[39m max_value = np.max(img_float)\n\u001b[32m      7\u001b[39m c_log = \u001b[32m255.0\u001b[39m / np.log(\u001b[32m1.0\u001b[39m + max_pixel)\n",
      "\u001b[31mNameError\u001b[39m: name 'imagch' is not defined"
     ]
    }
   ],
   "source": [
    "import cv2\n",
    "import numpy as np\n",
    "imgc=cv2.imread(\"image.jpg\")\n",
    "negative=imagch.invert(img)\n",
    "img_float = img.astype(np.float32)\n",
    "max_value = np.max(img_float)\n",
    "c_log = 255.0 / np.log(1.0 + max_pixel)\n",
    "# Apply the formula: S = c * log(1 + R)\n",
    "log_transformed = c_log * np.log(1.0 + img_float)\n",
    "\n",
    "# Convert back to regular 8-bit image format (0-255 integers)\n",
    "log_transformed = np.uint8(log_transformed)\n",
    "\n",
    "gamma = 2.0\n",
    "c_gamma = 255.0 / (max_pixel ** gamma)\n",
    "\n",
    "# Apply the formula: S = c * (R ^ gamma)\n",
    "gamma_transformed = c_gamma * (img_float ** gamma)\n",
    "\n",
    "# Convert back to regular 8-bit image format\n",
    "gamma_transformed = np.uint8(gamma_transformed)\n",
    "\n",
    "# ==========================================\n",
    "# SAVE THE RESULTS\n",
    "# ==========================================\n",
    "cv2.imwrite('log_transformed.jpg', log_transformed)\n",
    "cv2.imwrite('gamma_transformed.jpg', gamma_transformed)\n",
    "\n",
    "print(\"Transformations saved successfully!\")\n",
    "\n"
   ]
  }
