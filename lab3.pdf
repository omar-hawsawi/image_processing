   "source": [
    "imgclored=cv2.imread('mario.jpg')\n",
    "yuv_img = cv2.cvtColor(imgclored, cv2.COLOR_BGR2YUV)\n",
    "cv2.imshow('Y channel', yuv_img[:, :, 0]) \n",
    "cv2.imshow('U channel', yuv_img[:, :, 1])\n",
    "cv2.imshow('V channel', yuv_img[:, :, 2])\n",
    "cv2.waitKey()\n"
   ]
  },
